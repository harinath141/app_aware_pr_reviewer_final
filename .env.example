GITHUB_WEBHOOK_SECRET=replace-with-long-random-secret
# Needs Pull requests READ AND WRITE (post/edit review comments), Issues read/write, Metadata
# read, and Contents READ AND WRITE. "Issues: read and write" alone is NOT enough to comment on
# a pull request -- GitHub gates PR comments on the Pull requests permission. Contents: write is
# needed only to auto-resolve review threads (undocumented: resolveReviewThread is refused with
# FORBIDDEN under a read-only Contents token); without it, unresolved threads block merging on a
# branch that requires conversation resolution.
# The service account the onboarding wizard tells users to grant access to. Used for any owner
# that has no per-owner credential stored in Settings.
GITHUB_TOKEN=github_pat_replace_me

# Fernet key encrypting per-owner tokens AND users' GitHub OAuth tokens at rest.
# Generate: python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# !! BACK IT UP WITH THIS FILE !! Losing it makes every stored credential permanently
# undecryptable, and signs every user out of GitHub. It cannot be auto-generated because the app
# container has no volume, so a key file written inside it is destroyed on every rebuild.
GITHUB_CREDENTIAL_KEY=

# Optional extra gate on the credential settings routes. Redundant now that those routes require
# an admin session; kept for compatibility.
GITHUB_SETTINGS_ADMIN_TOKEN=

# --- GitHub Enterprise Server ------------------------------------------------------------------
# Blank means github.com. On GHES this is https://<your-host>/api/v3. GraphQL and OAuth are
# derived from it and are NOT under /api/v3 -- leave the two below blank unless you need to
# override them.
GITHUB_API_URL=
GITHUB_GRAPHQL_URL=
# Public address of this app, used to show users the real webhook payload URL during onboarding.
PUBLIC_BASE_URL=http://localhost:8010

# --- Sign-in (LDAP) ----------------------------------------------------------------------------
# With AUTH_REQUIRED on, the app REFUSES TO START unless ldap_server, base_dn and bind_dn are all
# set. That is deliberate: the alternative is coming up in a state nobody can log into.
# Set AUTH_REQUIRED=false only for a local trial -- it makes the dashboard open to anyone who can
# reach the port.
AUTH_REQUIRED=true
SESSION_TTL_HOURS=12
# Set false only when serving over plain http, otherwise the browser will not send the cookie.
SESSION_COOKIE_SECURE=true

LDAP_SERVER=ldaps://dc1.corp.example.com
LDAP_BASE_DN=DC=corp,DC=example,DC=com
# Service account used to find the user entry. The user's OWN password is then verified by
# re-binding as the DN that search returned -- it is never compared against a stored hash.
LDAP_BIND_DN=CN=svc-contextguard,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=replace-me
# Attribute the typed username is matched against: sAMAccountName (AD), userPrincipalName, or uid.
LDAP_USER_ATTRIBUTE=sAMAccountName
# Membership is read from the memberOf attribute, matched on the CN so a group can be moved
# between OUs without revoking everyone.
LDAP_ADMIN_GROUP=CONTEXTGUARD-ADMIN
LDAP_USER_GROUP=CONTEXTGUARD-USER
LDAP_TIMEOUT_SECONDS=10

# --- GitHub OAuth (which repositories a user can see) -------------------------------------------
# Register an OAuth App on your GHES instance. Leaving these blank disables the Connect GitHub
# button; users then see only the repositories they onboard themselves.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must match the callback registered on the OAuth App. Blank derives it from the request URL.
OAUTH_CALLBACK_URL=

LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DATABASE_URL=postgresql://reviewer:change-me@db:5432/reviewer
MAX_ARCHIVE_BYTES=50000000
MAX_FILES=12000
MAX_FILE_BYTES=500000
MAX_CHUNK_CHARS=3500
MAX_CONTEXT_CHUNKS=12
MAX_DIFF_CHARS=40000
